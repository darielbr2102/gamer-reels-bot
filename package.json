{
  "name": "gamer-reels-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "generate": "node scripts/generate.mjs",
    "render": "remotion render src/index.ts GamerSetup out/video.mp4 --props=data/props.json",
    "publish": "node scripts/publish.mjs",
    "daily": "npm run generate && npm run render && npm run publish"
  },
  "dependencies": {
    "@remotion/cli": "4.0.250",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.250"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "typescript": "5.5.4"
  }
}
